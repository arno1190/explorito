# Application
APP_NAME="Explorito - Application Educative"
APP_VERSION="1.0.0"
DEBUG=True
API_PREFIX="/api/v1"

# Security
SECRET_KEY="change-me-to-a-secure-random-string-min-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL="postgresql://explorito:explorito123@postgres:5432/explorito"

# CORS
CORS_ORIGINS="http://localhost:3005,http://127.0.0.1:3005"

# Upload
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE=10485760

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Gamification
XP_PER_EXERCISE=10
XP_PER_LESSON=50
XP_LEVEL_MULTIPLIER=100

# Email (annonces produit) — laisser SMTP_HOST vide désactive tout envoi
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_STARTTLS=True
SMTP_SSL=False
MAIL_FROM="arnaud@pascalfamily.fr"
MAIL_FROM_NAME="Explorito"
MAIL_REPLY_TO="arnaud@pascalfamily.fr"
PUBLIC_APP_URL="http://localhost:3005"
