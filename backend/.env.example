# Application
APP_NAME="Explorito - Application Educative"
APP_VERSION="1.0.0"
DEBUG=True
API_PREFIX="/api/v1"

# Security
SECRET_KEY="change-me-to-a-secure-random-string-min-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL="postgresql://explorito:explorito123@postgres:5432/explorito"

# CORS
CORS_ORIGINS="http://localhost:3005,http://127.0.0.1:3005"

# Upload
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE=10485760

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Gamification
XP_PER_EXERCISE=10
XP_PER_LESSON=50
XP_LEVEL_MULTIPLIER=100
