      "level": "ce1",
      "tier": 1,
      "name": "01 · La portée et la pulsation",
      "description": "Solfège 1C1 : La portée et la pulsation.",
      "exercises": [
        {
          "type": "reading",
          "question": "Découvre la leçon.",
          "content": {
            "text": "Une portée a cinq lignes et quatre interlignes. On lit de gauche à droite. La pulsation est un battement régulier : marche doucement sur place en gardant la même vitesse. La clé de sol indique où lire les notes."
          },
          "correct_answer": {},
          "difficulty_level": 1,
          "explanation": null
        },
        {
          "type": "multiple_choice",
          "question": "Combien de lignes contient une portée ?",
          "content": {
            "options": [
              {
                "id": "a",
                "text": "Cinq lignes"
              },
              {
                "id": "b",
                "text": "Quatre lignes"
              }
            ],
            "multiple": false
          },
          "correct_answer": {
            "option_ids": [
              "a"
            ]
          },
          "difficulty_level": 1,
          "explanation": "La portée contient cinq lignes ; les espaces entre elles sont les interlignes."
        },
        {
          "type": "multiple_choice",
          "question": "Comment bat une pulsation régulière ?",
          "content": {
            "options": [
              {
                "id": "a",
                "text": "À la même vitesse"
              },
              {
                "id": "b",
                "text": "De plus en plus vite"
