# Database
POSTGRES_USER=explorito
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=explorito

# Backend
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
CORS_ORIGINS=https://explorito.example.com

# Frontend
NEXT_PUBLIC_API_URL=https://api.explorito.example.com

# Caddy
DOMAIN=explorito.example.com

# URL publique du frontend, utilisée par le backend pour fabriquer des liens
# sortants : aperçu d'un pack rendu au contributeur, et lien de désinscription
# des emails d'annonce. À définir absolument : le défaut est une URL de
# développement (http://localhost:3005), qui partirait telle quelle dans de
# vrais emails.
PUBLIC_APP_URL=https://explorito.example.com

# Jeton donnant accès *uniquement* à /api/v1/moderation/* (compétence de revue
# des packs communautaires). Laisser vide désactive cette porte ; la session
# admin reste le chemin normal. Générer avec: openssl rand -hex 32
MODERATION_TOKEN=

# Envoi des annonces produit (emails aux parents). Laisser vide tant qu'aucun
# serveur SMTP n'est configuré : l'envoi est alors refusé proprement (503) au
# lieu d'échouer silencieusement.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=arnaud@pascalfamily.fr
MAIL_FROM_NAME=Explorito
MAIL_REPLY_TO=arnaud@pascalfamily.fr
